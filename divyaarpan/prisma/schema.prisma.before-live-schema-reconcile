generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         UserRole
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  devotee      Devotee?
  pandit       Pandit?

  @@index([role])
}

model AuthSession {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Temple {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  name          String
  city          String
  state         String
  address       String
  description   String
  openingTime   String
  closingTime   String
  mapUrl        String
  featuredImage String
  isFeatured    Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  facilities    Facility[]
  galleries     Gallery[]
  poojas        Pooja[]

  @@index([city])
  @@index([state])
  @@index([isFeatured])
}

model Pooja {
  id          Int      @id @default(autoincrement())
  templeId    Int
  name        String
  description String
  duration    String
  price       String
  image       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  temple      Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@index([templeId])
  @@index([name])
  @@index([isActive])
}

model Gallery {
  id        Int      @id @default(autoincrement())
  templeId  Int
  imageUrl  String
  createdAt DateTime @default(now())
  temple    Temple   @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@index([templeId])
}

model Facility {
  id       Int    @id @default(autoincrement())
  templeId Int
  facility String
  temple   Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@index([templeId])
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AstrologyBooking {
  id               Int       @id @default(autoincrement())
  bookingId        String    @unique
  service          String
  consultationMode String
  name             String
  mobile           String
  email            String
  birthDate        String
  birthTime        String
  birthPlace       String
  preferredDate    String
  preferredTime    String
  question         String
  amount           Int
  status           String    @default("Payment Pending")
  paymentStatus    String    @default("PENDING")
  paymentId        String?
  paymentOrderId   String?
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  devoteeId        Int?
  devotee          Devotee?  @relation(fields: [devoteeId], references: [id])

  @@index([devoteeId])
  @@index([status])
  @@index([createdAt])
}

model Booking {
  id             Int                    @id @default(autoincrement())
  bookingId      String                 @unique
  temple         String
  pooja          String
  price          String
  duration       String
  name           String
  mobile         String
  email          String
  date           String
  time           String
  devotees       Int
  sankalp        String?
  status         String                 @default("Payment Pending")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  amount         Int?
  confirmedAt    DateTime?
  paymentId      String?
  paymentOrderId String?
  paymentStatus  String                 @default("PENDING")
  poojaMode      String                 @default("DEVOTEE_PRESENT")
  devoteeId      Int?
  devotee        Devotee?               @relation(fields: [devoteeId], references: [id])
  statusHistory  BookingStatusHistory[]

  @@index([mobile])
  @@index([devoteeId])
  @@index([status])
  @@index([createdAt])
}

model BookingStatusHistory {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  fromStatus String?
  toStatus   String
  actorRole  String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Devotee {
  id                Int                @id @default(autoincrement())
  name              String
  mobile            String             @unique
  email             String?            @unique
  city              String?
  state             String?
  country           String             @default("India")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userId            Int?               @unique
  astrologyBookings AstrologyBooking[]
  bookings          Booking[]
  user              User?              @relation(fields: [userId], references: [id])
  panditBookings    PanditBooking[]

  @@index([city])
  @@index([isActive])
}

model Pandit {
  id                 Int                      @id @default(autoincrement())
  panditCode         String                   @unique
  name               String
  mobile             String                   @unique
  email              String?                  @unique
  profileImage       String?
  gender             String?
  dateOfBirth        DateTime?
  experienceYears    Int                      @default(0)
  bio                String?
  city               String
  state              String
  country            String                   @default("India")
  address            String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  verificationStatus PanditVerificationStatus @default(PENDING)
  /// *
  ///    * Controls whether the Pandit is active on DivyaArpan.
  ///    * Deactivation does NOT delete the Pandit and does NOT
  ///    * automatically remove their VERIFIED status.
  isActive           Boolean                  @default(true)
  /// *
  ///    * Online means the Pandit is currently accepting
  ///    * marketplace requests.
  ///    * When Admin deactivates a Pandit, our API will
  ///    * automatically set this to false.
  isOnline           Boolean                  @default(false)
  /// *
  ///    * Pandit may separately choose whether they
  ///    * accept immediate or scheduled bookings.
  acceptsImmediate   Boolean                  @default(true)
  acceptsScheduled   Boolean                  @default(true)
  rating             Float                    @default(0)
  totalRatings       Int                      @default(0)
  totalBookings      Int                      @default(0)

  /// Pandit Partner Agreement accepted during onboarding.
  partnerAgreementAcceptedAt DateTime?
  partnerAgreementVersion    String?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// *
  ///    * Timestamp of the most recent deactivation.
  deactivatedAt       DateTime?
  /// *
  ///    * Admin deactivation audit information.
  ///    * Reason should contain the selected primary reason.
  ///    * Remarks can contain additional Admin notes.
  deactivationReason  String?
  deactivationRemarks String?
  /// *
  ///    * Timestamp of the most recent reactivation.
  reactivatedAt       DateTime?
  userId              Int?                 @unique
  user                User?                @relation(fields: [userId], references: [id])
  availability        PanditAvailability[]
  assignedBookings    PanditBooking[]      @relation("AssignedPandit")
  bookingOffers       PanditBookingOffer[]
  documents           PanditDocument[]
  languages           PanditLanguage[]
  services            PanditService[]
  serviceAreas        PanditServiceArea[]

  @@index([city])
  @@index([state])
  @@index([isOnline])
  @@index([isActive])
  @@index([verificationStatus])
  @@index([city, isOnline, isActive, verificationStatus])
}

model PanditLanguage {
  id        Int      @id @default(autoincrement())
  panditId  Int
  language  String
  createdAt DateTime @default(now())
  pandit    Pandit   @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@unique([panditId, language])
  @@index([language])
}

model PanditService {
  id              Int      @id @default(autoincrement())
  panditId        Int
  serviceName     String
  /// *
  ///    * Amount in paise.
  ///    * Example:
  ///    * ₹1,500 = 150000
  ///    * This is better than storing money as String.
  basePrice       Int?
  durationMinutes Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pandit          Pandit   @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@unique([panditId, serviceName])
  @@index([serviceName])
  @@index([isActive])
}

model PanditServiceArea {
  id              Int      @id @default(autoincrement())
  panditId        Int
  city            String
  area            String
  pincode         String?
  /// *
  ///    * Useful later for location-based matching.
  latitude        Float?
  longitude       Float?
  serviceRadiusKm Float?
  createdAt       DateTime @default(now())
  pandit          Pandit   @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([area])
  @@index([pincode])
  @@index([panditId, city])
}

model PanditAvailability {
  id          Int      @id @default(autoincrement())
  panditId    Int
  /// *
  ///    * 0 = Sunday
  ///    * 1 = Monday
  ///    * ...
  ///    * 6 = Saturday
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pandit      Pandit   @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@index([panditId])
  @@index([dayOfWeek])
}

model PanditDocument {
  id             Int      @id @default(autoincrement())
  panditId       Int
  documentType   String
  documentUrl    String
  documentNumber String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pandit         Pandit   @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@index([panditId])
  @@index([isVerified])
}

model PanditBooking {
  id               Int                          @id @default(autoincrement())
  bookingId        String                       @unique
  /// *
  ///    * Pooja / service requested.
  service          String
  /// *
  ///    * Pooja location.
  city             String
  address          String
  /// *
  ///    * Pandit language preference.
  language         String
  /// *
  ///    * Existing fields retained so current pages
  ///    * do not break.
  ///    * We can migrate these to DateTime later.
  date             String
  time             String
  sankalp          String?
  /// *
  ///    * Devotee snapshot.
  ///    * We keep these even when devoteeId exists because
  ///    * booking records should preserve the information
  ///    * used at the time of booking.
  devoteeName      String
  mobile           String
  email            String?
  /// *
  ///    * Pandit Assignment
  panditId         Int?
  /// *
  ///    * Keep panditName as a historical snapshot.
  panditName       String?
  /// *
  ///    * Amount stored in paise.
  ///    * Example:
  ///    * ₹2,000 = 200000
  amount           Int?
  /// *
  ///    * Payment gateway details.
  paymentId        String?
  paymentOrderId   String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  assignedAt       DateTime?
  /// *
  ///    * Immediate or scheduled.
  bookingType      PanditBookingType            @default(SCHEDULED)
  cancelledAt      DateTime?
  completedAt      DateTime?
  confirmedAt      DateTime?
  /// *
  ///    * Devotee relation is optional initially so our
  ///    * existing booking flow continues to work even
  ///    * before customer login is introduced.
  devoteeId        Int?
  latitude         Float?
  longitude        Float?
  pincode          String?
  /// *
  ///    * Matching timestamps.
  searchStartedAt  DateTime?
  state            String?
  urgency          PanditUrgency                @default(SCHEDULED)
  status           PanditBookingStatus          @default(REQUESTED)
  paymentStatus    PanditPaymentStatus          @default(PENDING)
  discount         Int?                         @default(0)
  poojaCharges     Int?
  quotationRemarks String?
  quotationSentAt  DateTime?
  samagriCharges   Int?
  travelCharges    Int?
  devotee          Devotee?                     @relation(fields: [devoteeId], references: [id])
  assignedPandit   Pandit?                      @relation("AssignedPandit", fields: [panditId], references: [id])
  offers           PanditBookingOffer[]
  statusHistory    PanditBookingStatusHistory[]

  @@index([devoteeId])
  @@index([panditId])
  @@index([city])
  @@index([service])
  @@index([language])
  @@index([bookingType])
  @@index([urgency])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([city, service, language, status])
}

model PanditBookingStatusHistory {
  id         Int                  @id @default(autoincrement())
  bookingId  Int
  fromStatus PanditBookingStatus?
  toStatus   PanditBookingStatus
  actorRole  String?
  createdAt  DateTime             @default(now())
  booking    PanditBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model PanditBookingOffer {
  id            Int               @id @default(autoincrement())
  bookingId     Int
  panditId      Int
  status        PanditOfferStatus @default(PENDING)
  dispatchRound Int               @default(1)
  offeredAt     DateTime          @default(now())
  expiresAt     DateTime?
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  offeredAmount Int?
  booking       PanditBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pandit        Pandit            @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@unique([bookingId, panditId])
  @@index([bookingId])
  @@index([panditId])
  @@index([status])
  @@index([panditId, status])
}

enum PanditVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PanditBookingType {
  IMMEDIATE
  SCHEDULED
}

enum PanditUrgency {
  ASAP
  WITHIN_1_HOUR
  WITHIN_2_HOURS
  WITHIN_4_HOURS
  SCHEDULED
}

enum PanditBookingStatus {
  REQUESTED
  SEARCHING
  PANDIT_ASSIGNED
  AWAITING_PAYMENT
  CONFIRMED
  PANDIT_ON_THE_WAY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_PANDIT_AVAILABLE
}

enum PanditPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PanditOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum UserRole {
  ADMIN
  PANDIT
  DEVOTEE
}
