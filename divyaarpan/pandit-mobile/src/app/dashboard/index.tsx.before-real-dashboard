export default function DashboardScreen() {
  const [isOnline, setIsOnline] = useState(true);
  const [panditName, setPanditName] = useState("Pandit Ji");

  useEffect(() => {
    let mounted = true;

    const loadPanditProfile = async () => {
      try {
        const response = await panditApiFetch("/api/pandit/me");
        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error || "Unable to load Pandit profile."
          );
        }

        if (
          result.pandit?.verificationStatus ===
          "PENDING"
        ) {
          router.replace(
            "/verification-pending"
          );
          return;
        }

        if (
          result.pandit?.verificationStatus !==
            "VERIFIED" ||
          result.pandit?.isActive !== true
        ) {
          router.replace("/");
          return;
        }

        if (mounted && result.pandit?.name) {
          setPanditName(result.pandit.name);
        }

        if (
          mounted &&
          typeof result.pandit?.isOnline === "boolean"
        ) {
          setIsOnline(result.pandit.isOnline);
        }
      } catch (error) {
        const message =
          error instanceof Error ? error.message : "";

        if (
          message === "AUTH_REQUIRED" ||
          message === "SESSION_EXPIRED"
        ) {
          router.replace("/");
          return;
        }

        console.error("Unable to load Pandit profile:", error);
      }
    };

    loadPanditProfile();

    return () => {
      mounted = false;
    };
  }, []);

  return (
    <PanditShell
  activeTab="home"
  notificationCount={2}
  onTabPress={(tab) => {
  if (tab === "home") router.replace("/dashboard");
  if (tab === "requests") router.replace("/requests");
  if (tab === "bookings") router.replace("/bookings");
  if (tab === "notifications") router.replace("/notifications");
  if (tab === "profile") router.replace("/profile");
}}
>
      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        {/* Welcome */}
        <View style={styles.welcomeRow}>
          <View style={styles.welcomeText}>
            <Text style={styles.greeting}>
              Namaste, {panditName} 🙏
            </Text>
            <Text style={styles.subtitle}>
              Your DivyaArpan partner dashboard
            </Text>
          </View>

          <Pressable
            onPress={() => setIsOnline((value) => !value)}
            style={[
              styles.onlineBadge,
              !isOnline && styles.offlineBadge,
            ]}
          >
            <View
              style={[
                styles.onlineDot,
                !isOnline && styles.offlineDot,
              ]}
            />
            <Text
              style={[
                styles.onlineText,
                !isOnline && styles.offlineText,
              ]}
            >
              {isOnline ? "Online" : "Offline"}
            </Text>
          </Pressable>
        </View>

        {/* Availability banner */}
        <View style={styles.availabilityCard}>
          <View style={styles.availabilityIcon}>
            <Ionicons
              name={isOnline ? "radio-outline" : "moon-outline"}
              size={22}
              color={isOnline ? Colors.success : Colors.textSecondary}
            />
          </View>

          <View style={styles.availabilityContent}>
            <Text style={styles.availabilityTitle}>
              {isOnline ? "You are available" : "You are offline"}
            </Text>

            <Text style={styles.availabilityText}>
              {isOnline
                ? "You can receive new booking requests."
                : "You won't receive new booking requests."}
            </Text>
          </View>

          <Pressable
            onPress={() => setIsOnline((value) => !value)}
            style={styles.toggleButton}
          >
            <Text style={styles.toggleButtonText}>
              {isOnline ? "Go Offline" : "Go Online"}
            </Text>
          </Pressable>
        </View>

        {/* Stats */}
        <View style={styles.statsGrid}>
