              <View style={styles.rejectActions}>
                <Pressable
                  onPress={() => {
                    setShowReject(false);
                    setRejectReason("");
                  }}
                  style={styles.cancelRejectButton}
                >
                  <Text style={styles.cancelRejectText}>
                    Cancel
                  </Text>
                </Pressable>

