  disabled={!rejectReason.trim()}
  onPress={() => {
    setRejected(true);
    setShowReject(false);
  }}
  style={[
    styles.confirmRejectButton,
    !rejectReason.trim() && styles.disabledButton,
  ]}
>
                  <Text style={styles.confirmRejectText}>
                    Confirm Rejection
                  </Text>
                </Pressable>
              </View>
            </View>
          )}

          {/* Actions */}
          {!showReject && (
            <View style={styles.actions}>
              <Pressable
                onPress={() => setShowReject(true)}
                style={({ pressed }) => [
                  styles.rejectButton,
                  pressed && styles.pressed,
                ]}
              >
                <Ionicons
                  name="close-outline"
                  size={18}
                  color={Colors.error}
                />
                <Text style={styles.rejectText}>Reject</Text>
              </Pressable>

              <Pressable
  disabled={rejected}
  onPress={() => {}}
  style={({ pressed }) => [
    styles.acceptButton,
    rejected && styles.disabledButton,
    pressed && styles.acceptPressed,
  ]}
>
                <Ionicons
                  name="checkmark-outline"
                  size={18}
                  color={Colors.white}
                />

                <Text style={styles.acceptText}>
                  Accept Request
                </Text>
