            <Text style={styles.policyText}>
              Please confirm that you can reach the location,
              perform the selected pooja at the requested time,
              and fulfil the Samagri requirement.
            </Text>
          </View>
        </View>

        <View style={{ height: Spacing.xl }} />
      </ScrollView>
    </PanditShell>
