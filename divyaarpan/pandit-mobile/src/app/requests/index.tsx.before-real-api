function Requirement({
  icon,
  title,
  value,
  positive,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  title: string;
  value: string;
  positive?: boolean;
}) {
  return (
    <View style={styles.requirement}>
      <Ionicons
        name={icon}
        size={16}
        color={positive ? Colors.success : Colors.textSecondary}
      />

      <View style={styles.requirementText}>
        <Text style={styles.requirementTitle}>{title}</Text>
        <Text
          style={[
            styles.requirementValue,
            positive && styles.positiveValue,
          ]}
        >
          {value}
        </Text>
      </View>
    </View>
  );
}

