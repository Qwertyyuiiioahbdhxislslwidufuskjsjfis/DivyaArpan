import { router } from "expo-router";
import React, { useState } from "react";
import {
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import PanditShell from "@/components/pandit/PanditShell";
import { Colors, Radius, Spacing } from "@/constants/theme";

type Filter = "All" | "New" | "Accepted" | "Rejected";

export default function RequestsScreen() {
  const [filter, setFilter] = useState<Filter>("All");
  const [showReject, setShowReject] = useState(false);
const [rejectReason, setRejectReason] = useState("");
const [rejected, setRejected] = useState(false);
  return (
    <PanditShell
      activeTab="requests"
      notificationCount={2}
      onTabPress={(tab) => {
        if (tab === "home") router.replace("/dashboard");
        if (tab === "requests") router.replace("/requests");
        if (tab === "bookings") router.replace("/bookings");
        if (tab === "notifications") router.replace("/notifications");
        if (tab === "profile") router.replace("/profile");
      }}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        {/* Header */}
        <View style={styles.headerRow}>
          <View style={styles.headerText}>
            <Text style={styles.title}>Booking Requests</Text>
            <Text style={styles.subtitle}>
              Review and respond to customer requests
            </Text>
          </View>

          <View style={styles.countBadge}>
            <Text style={styles.countText}>1</Text>
          </View>
        </View>

        {/* Filters */}
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          contentContainerStyle={styles.filters}
        >
          {(["All", "New", "Accepted", "Rejected"] as Filter[]).map(
            (item) => (
              <Pressable
                key={item}
                onPress={() => setFilter(item)}
                style={[
                  styles.filterChip,
                  filter === item && styles.filterChipActive,
                ]}
              >
                <Text
                  style={[
                    styles.filterText,
                    filter === item && styles.filterTextActive,
                  ]}
                >
                  {item}
                </Text>
              </Pressable>
            )
          )}
        </ScrollView>

        {/* Section heading */}
        <View style={styles.sectionHeader}>
          <View>
            <Text style={styles.sectionTitle}>New Requests</Text>
            <Text style={styles.sectionSubtitle}>
              Requests waiting for your response
            </Text>
          </View>

          <View style={styles.newBadge}>
            <Text style={styles.newBadgeText}>1 NEW</Text>
          </View>
        </View>

        {/* Request */}
        <View style={styles.card}>
          {/* Service header */}
          <Pressable
            onPress={() => router.push("/requests/DA-REQ-001")}
            style={({ pressed }) => [
              styles.requestHeader,
              pressed && styles.pressed,
            ]}
          >
            <View style={styles.serviceIcon}>
              <Ionicons
                name="sparkles-outline"
                size={23}
                color={Colors.primary}
              />
            </View>

            <View style={styles.serviceInfo}>
              <Text style={styles.serviceName}>
                Satyanarayan Pooja
              </Text>

              <Text style={styles.bookingId}>
                Booking Request · DA-REQ-001
              </Text>
            </View>

            <View
  style={[
    styles.pendingBadge,
    rejected && styles.rejectedBadge,
  ]}
>
  <View
    style={[
      styles.pendingDot,
      rejected && styles.rejectedDot,
    ]}
  />
  <Text
    style={[
      styles.pendingText,
      rejected && styles.rejectedText,
    ]}
  >
    {rejected ? "Rejected" : "Pending"}
  </Text>
</View>
          </Pressable>

          <View style={styles.divider} />

          {/* Schedule */}
          <View style={styles.highlightRow}>
            <View style={styles.highlightItem}>
              <View style={styles.smallIcon}>
                <Ionicons
                  name="calendar-outline"
                  size={17}
                  color={Colors.primary}
                />
              </View>

              <View>
                <Text style={styles.label}>Date & Time</Text>
                <Text style={styles.value}>Today · 6:00 PM</Text>
              </View>
            </View>

            <View style={styles.highlightItem}>
              <View style={styles.smallIcon}>
                <Ionicons
                  name="location-outline"
                  size={17}
                  color={Colors.primary}
                />
              </View>

              <View style={styles.locationInfo}>
                <Text style={styles.label}>Location</Text>
                <Text style={styles.value}>Andheri West</Text>
              </View>
            </View>
          </View>

          {/* Customer */}
          <View style={styles.customerSection}>
            <Text style={styles.sectionLabel}>Devotee</Text>

            <View style={styles.customerRow}>
              <View style={styles.avatar}>
                <Text style={styles.avatarText}>R</Text>
              </View>

              <View style={styles.customerInfo}>
                <Text style={styles.customerName}>
                  Rahul Sharma
                </Text>
                <Text style={styles.customerLocation}>
                  Mumbai, Maharashtra
                </Text>
              </View>

              <Ionicons
                name="chevron-forward"
                size={18}
                color={Colors.textMuted}
              />
            </View>
          </View>

          {/* Requirements */}
