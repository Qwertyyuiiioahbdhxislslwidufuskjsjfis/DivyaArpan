import { router, useLocalSearchParams } from "expo-router";
import React, { useState } from "react";
import {
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import PanditShell from "@/components/pandit/PanditShell";
import { Colors, Radius, Spacing } from "@/constants/theme";

type BookingStage =
  | "confirmed"
  | "on_the_way"
  | "arrived"
  | "started"
  | "completed";

const stages: {
  key: BookingStage;
  label: string;
  icon: keyof typeof Ionicons.glyphMap;
}[] = [
  {
    key: "confirmed",
    label: "Confirmed",
    icon: "checkmark-circle-outline",
  },
  {
    key: "on_the_way",
    label: "On the Way",
    icon: "navigate-outline",
  },
  {
    key: "arrived",
    label: "Arrived",
    icon: "location-outline",
  },
  {
    key: "started",
    label: "Pooja Started",
    icon: "sparkles-outline",
  },
  {
    key: "completed",
    label: "Completed",
    icon: "checkmark-done-outline",
  },
];

export default function BookingDetailsScreen() {
  const { id } = useLocalSearchParams<{ id: string }>();

  const [stage, setStage] = useState<BookingStage>("confirmed");

  const currentIndex = stages.findIndex(
    (item) => item.key === stage
  );

  const nextStage = stages[currentIndex + 1];

  return (
    <PanditShell
      activeTab="bookings"
      notificationCount={2}
      onTabPress={(tab) => {
        if (tab === "home") router.replace("/dashboard");
        if (tab === "requests") router.replace("/requests");
        if (tab === "bookings") router.replace("/bookings");
        if (tab === "notifications") router.replace("/notifications");
        if (tab === "profile") router.replace("/profile");
      }}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        {/* Back */}
        <Pressable
          onPress={() => router.back()}
          style={styles.backButton}
        >
          <Ionicons
            name="arrow-back"
            size={20}
            color={Colors.text}
          />
          <Text style={styles.backText}>My Bookings</Text>
        </Pressable>

        {/* Booking Hero */}
        <View style={styles.hero}>
          <View style={styles.heroIcon}>
            <Ionicons
              name="sparkles-outline"
              size={30}
              color={Colors.primary}
            />
          </View>

          <Text style={styles.serviceName}>
            Satyanarayan Pooja
          </Text>

          <Text style={styles.bookingId}>
            {id || "DA-BKG-001"}
          </Text>

          <View style={styles.statusBadge}>
            <View style={styles.statusDot} />

            <Text style={styles.statusText}>
              {stages[currentIndex].label}
            </Text>
          </View>
        </View>

        {/* Progress */}
        <View style={styles.section}>
          <Text style={styles.sectionTitle}>
            Booking Progress
          </Text>

          <View style={styles.progressCard}>
            {stages.map((item, index) => {
              const completed = index <= currentIndex;
              const active = index === currentIndex;

              return (
                <View key={item.key} style={styles.progressItem}>
                  <View style={styles.progressLeft}>
                    <View
                      style={[
                        styles.progressIcon,
                        completed &&
                          styles.progressIconCompleted,
                        active && styles.progressIconActive,
                      ]}
                    >
                      <Ionicons
                        name={item.icon}
                        size={17}
                        color={
                          completed
                            ? Colors.white
                            : Colors.textMuted
                        }
                      />
                    </View>

                    {index < stages.length - 1 && (
                      <View
                        style={[
                          styles.progressLine,
                          index < currentIndex &&
                            styles.progressLineCompleted,
                        ]}
                      />
                    )}
                  </View>

                  <View style={styles.progressText}>
                    <Text
                      style={[
                        styles.progressLabel,
                        completed &&
                          styles.progressLabelCompleted,
                      ]}
                    >
                      {item.label}
                    </Text>

                    <Text style={styles.progressDescription}>
                      {getStageDescription(item.key)}
                    </Text>
                  </View>
                </View>
              );
            })}
          </View>
        </View>

        {/* Next Action */}
        {nextStage && (
          <View style={styles.nextActionCard}>
            <View style={styles.nextIcon}>
              <Ionicons
                name={nextStage.icon}
                size={22}
                color={Colors.primary}
              />
            </View>

            <View style={styles.nextContent}>
              <Text style={styles.nextLabel}>NEXT STEP</Text>

              <Text style={styles.nextTitle}>
                {nextStage.label}
              </Text>

              <Text style={styles.nextDescription}>
                Update the booking when you reach this stage.
              </Text>
            </View>
          </View>
        )}

        {/* Schedule */}
        <Section title="Schedule">
          <DetailRow
            icon="calendar-outline"
            label="Date"
            value="Today, 6 September 2026"
          />

          <DetailRow
            icon="time-outline"
            label="Time"
            value="6:00 PM"
          />

          <DetailRow
            icon="hourglass-outline"
            label="Booking Type"
            value="Scheduled"
          />
        </Section>

        {/* Customer */}
        <Section title="Devotee">
          <View style={styles.customerCard}>
            <View style={styles.avatar}>
              <Text style={styles.avatarText}>R</Text>
            </View>

            <View style={styles.customerInfo}>
              <Text style={styles.customerName}>
                Rahul Sharma
              </Text>

              <Text style={styles.customerLocation}>
                Mumbai, Maharashtra
              </Text>
            </View>
          </View>

          <DetailRow
            icon="call-outline"
            label="Contact"
            value="Available for this booking"
          />
        </Section>

        {/* Service */}
        <Section title="Pooja Details">
          <DetailRow
            icon="sparkles-outline"
            label="Service"
            value="Satyanarayan Pooja"
          />

          <DetailRow
            icon="cube-outline"
            label="Samagri"
            value="Required"
            positive
          />

          <DetailRow
            icon="language-outline"
            label="Language"
            value="Hindi"
          />

          <DetailRow
            icon="home-outline"
            label="Service Type"
            value="At Customer Location"
          />
        </Section>

        {/* Location */}
        <Section title="Service Location">
          <View style={styles.locationCard}>
            <View style={styles.locationIcon}>
              <Ionicons
                name="location-outline"
                size={22}
                color={Colors.primary}
              />
            </View>

            <View style={styles.locationContent}>
              <Text style={styles.locationTitle}>
                Andheri West
              </Text>

              <Text style={styles.locationCity}>
                Mumbai, Maharashtra
              </Text>

              <Text style={styles.locationNote}>
                Full customer address will be available
                according to booking access rules.
              </Text>
            </View>
          </View>

          <Pressable style={styles.mapButton}>
            <Ionicons
              name="navigate-outline"
              size={17}
              color={Colors.primary}
            />

            <Text style={styles.mapButtonText}>
              Open Navigation
            </Text>
          </Pressable>
        </Section>

        {/* Amount */}
        <View style={styles.amountCard}>
          <View style={styles.amountHeader}>
            <View>
              <Text style={styles.amountLabel}>
                DivyaArpan Booking Amount
              </Text>

              <Text style={styles.amount}>
                ₹2,100
              </Text>
            </View>

            <View style={styles.fixedBadge}>
              <Ionicons
                name="lock-closed-outline"
                size={14}
                color={Colors.primaryDark}
              />

              <Text style={styles.fixedText}>Fixed</Text>
            </View>
          </View>

          <View style={styles.amountDivider} />

          <Text style={styles.amountNote}>
            The customer price is controlled by DivyaArpan
            and cannot be modified by the Pandit partner.
          </Text>
        </View>

        {/* Action */}
        {nextStage ? (
          <Pressable
            onPress={() => setStage(nextStage.key)}
            style={styles.primaryAction}
          >
            <Ionicons
              name={nextStage.icon}
              size={20}
              color={Colors.white}
            />

            <Text style={styles.primaryActionText}>
              Mark as {nextStage.label}
            </Text>
          </Pressable>
        ) : (
          <View style={styles.completedCard}>
            <Ionicons
              name="checkmark-circle"
              size={25}
              color={Colors.success}
            />

            <View style={styles.completedContent}>
              <Text style={styles.completedTitle}>
                Booking Completed
              </Text>

              <Text style={styles.completedText}>
                This pooja has been marked as completed.
              </Text>
            </View>
          </View>
        )}

        <Text style={styles.footerNote}>
          Booking status updates will be synchronized with
          DivyaArpan once the API is connected.
        </Text>

        <View style={{ height: Spacing.xxl }} />
      </ScrollView>
    </PanditShell>
  );
}

function getStageDescription(stage: BookingStage) {
  switch (stage) {
    case "confirmed":
      return "Booking has been confirmed.";
    case "on_the_way":
      return "Pandit is travelling to the location.";
    case "arrived":
      return "Pandit has reached the customer location.";
    case "started":
      return "Pooja service is currently in progress.";
    case "completed":
      return "Pooja has been successfully completed.";
  }
}

function Section({
  title,
  children,
}: {
  title: string;
  children: React.ReactNode;
}) {
  return (
    <View style={styles.section}>
      <Text style={styles.sectionTitle}>{title}</Text>

      <View style={styles.sectionCard}>{children}</View>
    </View>
  );
}

function DetailRow({
  icon,
  label,
  value,
  positive,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  positive?: boolean;
}) {
  return (
    <View style={styles.detailRow}>
      <View style={styles.detailIcon}>
        <Ionicons
          name={icon}
          size={18}
          color={
            positive ? Colors.success : Colors.primary
          }
        />
      </View>

      <View style={styles.detailContent}>
        <Text style={styles.detailLabel}>{label}</Text>

        <Text
          style={[
            styles.detailValue,
            positive && styles.positiveValue,
          ]}
        >
          {value}
        </Text>
      </View>
    </View>
  );
}

