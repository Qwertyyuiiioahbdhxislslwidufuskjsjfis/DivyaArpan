import { NextResponse } from "next/server";
import { mkdir, writeFile } from "fs/promises";
import path from "path";
import crypto from "crypto";
import { prisma } from "@/lib/prisma";
import { getCurrentUserFromRequest } from "@/app/lib/auth";
import { addMobileCors } from "@/app/lib/mobile-cors";
import { normalizePanditDocumentType } from "@/app/lib/pandit-documents";

const MAX_FILE_SIZE = 5 * 1024 * 1024;

const ALLOWED_TYPES = [
  "image/jpeg",
  "image/png",
  "application/pdf",
];

function getExtension(type: string) {
  switch (type) {
    case "image/jpeg":
      return ".jpg";
    case "image/png":
      return ".png";
    case "application/pdf":
      return ".pdf";
    default:
      return "";
  }
}

export async function OPTIONS() {
  return addMobileCors(
    new NextResponse(null, { status: 204 })
  );
}

export async function GET(request: Request) {
  try {
    const user =
      await getCurrentUserFromRequest(request);

    if (
      !user ||
      user.role !== "PANDIT" ||
      !user.panditId
    ) {
      return addMobileCors(
        NextResponse.json(
          {
            message:
              "Pandit authentication required.",
          },
          { status: 403 }
        )
      );
    }

    const documents =
      await prisma.panditDocument.findMany({
        where: {
          panditId: user.panditId,
        },
        select: {
          id: true,
          documentType: true,
          documentNumber: true,
          isVerified: true,
          createdAt: true,
          updatedAt: true,
        },
        orderBy: {
          createdAt: "asc",
        },
      });

    return addMobileCors(
      NextResponse.json({
        documents,
      })
    );
  } catch (error) {
    console.error(
      "Pandit document status failed:",
      error
    );

    return addMobileCors(
      NextResponse.json(
        {
          message:
            "Failed to load document status.",
        },
        { status: 500 }
      )
    );
  }
}

export async function POST(request: Request) {
  try {
    const user =
      await getCurrentUserFromRequest(request);

    if (
      !user ||
      user.role !== "PANDIT" ||
      !user.panditId
    ) {
      return addMobileCors(
        NextResponse.json(
          {
            message:
              "Pandit authentication required.",
          },
          { status: 403 }
        )
      );
    }

    const contentType =
      request.headers.get("content-type") || "";

    console.log("[KYC UPLOAD] request received", {
      panditId: user.panditId,
      contentType,
    });

    let normalizedDocumentType: string | null =
      null;

    let documentNumber: string | null = null;
    let fileType = "";
    let bytes: Buffer;

    /*
     * Native Expo / React Native:
     * JSON + Base64 avoids unstable Android FormData.
     */
    if (
      contentType
        .toLowerCase()
        .includes("application/json")
    ) {
      const body = await request.json();

      const documentType =
        typeof body.documentType === "string"
          ? body.documentType
          : "";

      normalizedDocumentType =
        normalizePanditDocumentType(documentType);

      console.log("[KYC UPLOAD] mobile JSON metadata", {
        panditId: user.panditId,
        documentType,
        normalizedDocumentType,
        mimeType:
          typeof body.mimeType === "string"
            ? body.mimeType
            : null,
        documentNumberPresent:
          Boolean(
            typeof body.documentNumber === "string" &&
            body.documentNumber.trim()
          ),
        base64Length:
          typeof body.fileBase64 === "string"
            ? body.fileBase64.length
            : 0,
      });

      if (!normalizedDocumentType) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "A valid document type is required.",
            },
            { status: 400 }
          )
        );
      }

      fileType =
        typeof body.mimeType === "string"
          ? body.mimeType
              .toLowerCase()
              .trim()
          : "";

      if (!ALLOWED_TYPES.includes(fileType)) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "Only PDF, JPG and PNG documents are allowed.",
            },
            { status: 400 }
          )
        );
      }

      if (
        typeof body.fileBase64 !== "string" ||
        !body.fileBase64
      ) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "Please select a document.",
            },
            { status: 400 }
          )
        );
      }

      try {
        bytes = Buffer.from(
          body.fileBase64,
          "base64"
        );
      } catch {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "Unable to read the selected document.",
            },
            { status: 400 }
          )
        );
      }

      documentNumber =
        typeof body.documentNumber === "string" &&
        body.documentNumber.trim()
          ? body.documentNumber.trim()
          : null;
    } else {
      /*
       * Browser:
       * standard multipart FormData.
       */
      const formData =
        await request.formData();

      const file = Reflect.get(
        formData,
        "get"
      ).call(
        formData,
        "file"
      ) as FormDataEntryValue | null;

      const documentType = Reflect.get(
        formData,
        "get"
      ).call(
        formData,
        "documentType"
      ) as FormDataEntryValue | null;

      if (!(file instanceof File)) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "Please select a document.",
            },
            { status: 400 }
          )
        );
      }

      normalizedDocumentType =
        normalizePanditDocumentType(
          documentType
        );

      if (!normalizedDocumentType) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "A valid document type is required.",
            },
            { status: 400 }
          )
        );
      }

      fileType =
        file.type
          .toLowerCase()
          .trim();

      if (!ALLOWED_TYPES.includes(fileType)) {
        return addMobileCors(
          NextResponse.json(
            {
              message:
                "Only PDF, JPG and PNG documents are allowed.",
            },
            { status: 400 }
          )
        );
      }

      const arrayBuffer =
        await file.arrayBuffer();

      bytes = Buffer.from(arrayBuffer);

      const rawDocumentNumber =
        Reflect.get(
          formData,
          "get"
        ).call(
          formData,
          "documentNumber"
        ) as FormDataEntryValue | null;

      documentNumber =
        typeof rawDocumentNumber === "string" &&
        rawDocumentNumber.trim()
          ? rawDocumentNumber.trim()
          : null;
    }

    if (bytes.length === 0) {
      return addMobileCors(
        NextResponse.json(
          {
            message:
              "The selected document is empty.",
          },
          { status: 400 }
        )
      );
    }

    if (bytes.length > MAX_FILE_SIZE) {
      return addMobileCors(
        NextResponse.json(
          {
            message:
              "Document size must not exceed 5 MB.",
          },
          { status: 400 }
        )
      );
    }

    const safeDocumentType =
      normalizedDocumentType
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

    const fileName =
      `${safeDocumentType}-${crypto.randomUUID()}${getExtension(
        fileType
      )}`;

    const uploadDirectory = path.join(
      process.cwd(),
      "uploads",
      "pandits",
      "private"
    );

    await mkdir(
      uploadDirectory,
      { recursive: true }
    );

    const filePath =
      path.join(
        uploadDirectory,
        fileName
      );

    await writeFile(
      filePath,
      bytes
    );

    const documentData = {
      documentUrl:
        `private://${fileName}`,

      documentNumber,

      /*
       * Uploading/replacing a file requires
       * Admin verification again.
       */
      isVerified: false,
    };

    const existingDocument =
      await prisma.panditDocument.findFirst({
        where: {
          panditId: user.panditId,
          documentType:
            normalizedDocumentType,
        },
        select: {
          id: true,
        },
      });

    console.log("[KYC UPLOAD] saving document", {
      panditId: user.panditId,
      normalizedDocumentType,
      bytes: bytes.length,
      existingDocumentId:
        existingDocument?.id ?? null,
    });

    const document =
      existingDocument
        ? await prisma.panditDocument.update({
            where: {
              id: existingDocument.id,
            },
            data: documentData,
          })
        : await prisma.panditDocument.create({
            data: {
              panditId:
                user.panditId,

              documentType:
                normalizedDocumentType,

              ...documentData,
            },
          });

    console.log("[KYC UPLOAD] saved successfully", {
      panditId: user.panditId,
      documentId: document.id,
      documentType:
        normalizedDocumentType,
    });

    return addMobileCors(
      NextResponse.json(
        {
          success: true,

          documentId:
            document.id,

          documentUrl:
            `/api/pandits/${user.panditId}/documents/${document.id}/view`,

          fileName,

          documentType:
            normalizedDocumentType,
        },
        { status: 201 }
      )
    );
  } catch (error) {
    console.error(
      "Pandit document upload failed:",
      error
    );

    return addMobileCors(
      NextResponse.json(
        {
          message:
            "Failed to upload document.",
        },
        { status: 500 }
      )
    );
  }
}

