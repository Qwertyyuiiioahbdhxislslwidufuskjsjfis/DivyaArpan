import { NextResponse } from "next/server";
import {
  createSession,
  findUserByLogin,
  SESSION_COOKIE,
  verifyPassword,
} from "../../../lib/auth";
import { prisma } from "@/app/lib/prisma";
import { addMobileCors } from "../../../lib/mobile-cors";

export async function OPTIONS() {
  return addMobileCors(new NextResponse(null, { status: 204 }));
}

export async function POST(request: Request) {
  try {
    const body = await request.json();

    const loginId =
      typeof body.loginId === "string"
        ? body.loginId.trim()
        : typeof body.email === "string"
          ? body.email.trim()
          : "";

    const password =
      typeof body.password === "string" ? body.password : "";

    if (!loginId || !password) {
      return addMobileCors(
        NextResponse.json(
          {
            success: false,
            error: "Invalid Login ID or password.",
          },
          { status: 400 }
        )
      );
    }

    // Login using Email ID or Mobile Number.
    const user = await findUserByLogin(loginId);

    // Verify password.
    let passwordHash: string | undefined;

    if (user?.id) {
      const authUser = await prisma.user.findUnique({
        where: {
          id: user.id,
        },
        select: {
          passwordHash: true,
        },
      });

      passwordHash = authUser?.passwordHash ?? undefined;
    }

    if (
      !user?.id ||
      !passwordHash ||
      !(await verifyPassword(password, passwordHash))
    ) {
      return addMobileCors(
        NextResponse.json(
          {
            success: false,
            error: "Invalid Login ID or password.",
          },
          { status: 401 }
        )
      );
    }

    // Pandit accounts require Admin approval and active status.
    if (user.role === "PANDIT") {
      if (user.panditVerificationStatus !== "VERIFIED") {
        if (user.panditVerificationStatus === "PENDING") {
          const session = await createSession(user.id);

          const response = addMobileCors(
            NextResponse.json(
              {
                success: false,
                error: "Invalid Login ID or password.",
                pendingApproval: true,
              },
              { status: 403 }
            )
          );

          response.cookies.set(SESSION_COOKIE, session.sessionId, {
            httpOnly: true,
            secure: process.env.NODE_ENV === "production",
            sameSite: "lax",
            expires: session.expiresAt,
            path: "/",
          });

          return response;
        }

        return addMobileCors(
          NextResponse.json(
            {
              success: false,
              error: "Invalid Login ID or password.",
            },
            { status: 403 }
          )
        );
      }

      if (user.panditIsActive !== true) {
        return addMobileCors(
          NextResponse.json(
            {
              success: false,
              error: "Invalid Login ID or password.",
            },
            { status: 403 }
          )
        );
      }
    }

    const session = await createSession(user.id);

    const response = addMobileCors(
      NextResponse.json({
        success: true,
        user: {
          id: user.id,
          name: user.name,
          role: user.role,
        },
      })
    );

    response.cookies.set(SESSION_COOKIE, session.sessionId, {
      httpOnly: true,
      secure: process.env.NODE_ENV === "production",
      sameSite: "lax",
      expires: session.expiresAt,
      path: "/",
    });

    return response;
  } catch (error) {
    console.error("LOGIN ERROR:", error);

    return addMobileCors(
      NextResponse.json(
        {
          success: false,
          error: "Unable to sign in right now.",
        },
        { status: 500 }
      )
    );
  }
}
